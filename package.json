{
  "name": "@quadraticc/release-action",
  "version": "1.0.0",
  "private": true,
  "description": "Create immutable releases in Quadraticc from GitHub Actions.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/quadraticc/release-action.git"
  },
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "npm run compile && ncc build build/main.js -o dist --target es2022 --license licenses.txt",
    "compile": "tsc",
    "test": "npm run compile && node --test",
    "check": "tsc --noEmit"
  },
  "dependencies": {
    "@actions/core": "3.0.1"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "@vercel/ncc": "0.45.0",
    "selfsigned": "5.5.0",
    "typescript": "7.0.2",
    "yaml": "2.9.1"
  },
  "type": "module"
}
